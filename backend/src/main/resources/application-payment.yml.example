# ============================================================
# 支付配置模板 —— 复制为 application-payment.yml 后填入真实值
# application-payment.yml 已被 .gitignore 忽略，私钥/密钥不会入库。
# 默认 lanlink.payment.mock=true：不触达真实渠道，本地即可跑通全流程。
# 真实联调需：1) 部署到公网 HTTPS 域名 2) mock=false 3) 填齐对应渠道凭证。
# ============================================================
lanlink:
  payment:
    mock: true
    # 回调/跳转公网基址（真实环境替换为你的 HTTPS 域名，末尾不带 /api 时会自动拼 /payment/notify/...）
    notify-base-url: http://localhost:8080/api
    wechat:
      app-id: ""                # 微信 AppID
      mch-id: "1746178875"      # 商户号
      api-key: ""               # APIv2 商户密钥(32位)，商户平台设置，切勿入库
      cert-path: "E:/WXPay API Key/1746178875_20260622_cert/apiclient_cert.p12"
      sign-type: MD5            # MD5 | HMAC-SHA256
      trade-type: NATIVE        # NATIVE(扫码)
    alipay:
      gateway-url: https://openapi.alipay.com/gateway.do
      app-id: ""                # 支付宝应用 AppID
      private-key: ""           # 应用私钥(RSA2, PKCS8 base64)，切勿入库
      alipay-public-key: ""     # 支付宝公钥(验签用)
      sign-type: RSA2
      notify-url: ""            # 留空则用 notify-base-url 拼接
      return-url: ""
